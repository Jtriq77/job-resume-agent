# 模型平台 API Key（不是 DSH 账号登录 token）
# 在 https://platform.deepseek.com/ 的 API keys 页面创建
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：OpenAI 兼容端点
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 数据路径（默认即可）
JOBRADAR_HOME=./data/_raw_jobradar
JOBS_DB=./data/_raw_jobradar/jobs.db
JD_TEXT_DB=./data/_raw_jobradar/jd_text.db
